/-
  Intro.lean - Lean 4 最基础的入门

  这是最最简单的 Lean 4 入门教程。
  从 #eval 开始，一步步学习 Lean 的基础语法。

  使用方法：
  1. 在 VSCode 中打开此文件
  2. Lean 会自动执行 #eval 和 #check 命令
  3. 鼠标悬停在代码上可以查看类型信息
  4. 可以修改代码，Lean 会实时更新结果
-/

-- ============================================================================
-- 第一部分：#eval - 计算表达式
-- ============================================================================

/-
`#eval` 是 Lean 的交互式求值命令。
它会计算后面的表达式并显示结果。

你可以在 VSCode 中看到计算结果。
-/

-- 最简单的算术
#eval 1 + 1
#eval 2 + 3
#eval 10 - 4
#eval 3 * 5
#eval 12 / 4

-- 更复杂的算术
#eval 100 + 200 + 300
#eval (2 + 3) * 4
#eval 2 ^ 10

-- ============================================================================
-- 第二部分：#check - 查看类型
-- ============================================================================

/-
`#check` 用于查看一个表达式的类型。
在 Lean 中，每个表达式都有一个类型。
-/

-- 数字的类型
#check 1
#check 1 + 1

-- 布尔值
#check true
#check false

-- 字符串
#check "hello"
#check "你好，世界"

-- ============================================================================
-- 第三部分：基本数据类型
-- ============================================================================

/-
Lean 有几种基本数据类型：

- Nat    : 自然数 (0, 1, 2, 3, ...)
- Int    : 整数 (..., -2, -1, 0, 1, 2, ...)
- Bool   : 布尔值 (true, false)
- String : 字符串
-/

-- Nat: 自然数
#eval (0 : Nat)
#eval (42 : Nat)
#eval (100 + 200 : Nat)

-- Int: 整数（可以表示负数）
#eval (-5 : Int)
#eval (3 - 10 : Int)

-- Bool: 布尔值
#eval true
#eval false
#eval !true        -- 逻辑非
#eval true && false  -- 逻辑与
#eval true || false  -- 逻辑或

-- String: 字符串
#eval "Hello"
#eval "Lean 4 真有趣"

-- ============================================================================
-- 第四部分：def - 定义变量和常量
-- ============================================================================

/-
用 `def` 可以定义命名值。

格式：
  def 名称 := 值
  def 名称 : 类型 := 值
-/

-- 简单的常量定义
def myAge := 20
def myName := "小明"

-- 带类型注解的定义
def pi : Float := 3.14159
def isLeanFun : Bool := true

-- 使用定义的值
#eval myAge
#eval myName
#eval pi
#eval isLeanFun

-- 定义计算结果
def sum := 1 + 2 + 3 + 4 + 5
#eval sum

def product := 2 * 3 * 4
#eval product

-- ============================================================================
-- 第五部分：函数定义
-- ============================================================================

/-
函数也是用 `def` 定义的。

格式：
  def 函数名 (参数1 : 类型1) (参数2 : 类型2) : 返回类型 :=
    函数体
-/

-- 最简单的函数：加 1
def addOne (n : Nat) : Nat :=
  n + 1

#eval addOne 5
#eval addOne 10

-- 两数相加
def add (a : Nat) (b : Nat) : Nat :=
  a + b

#eval add 3 4
#eval add 100 200

-- 求平方
def square (n : Nat) : Nat :=
  n * n

#eval square 5
#eval square 12

-- 判断是否为偶数
def isEven (n : Nat) : Bool :=
  n % 2 = 0

#eval isEven 4
#eval isEven 7

-- ============================================================================
-- 第六部分：条件表达式
-- ============================================================================

/-
Lean 使用 `if ... then ... else ...` 进行条件判断。
-/

-- 绝对值
def abs (n : Int) : Int :=
  if n >= 0 then n else -n

#eval abs 5
#eval abs (-3)

-- 求最大值
def maxNat (a b : Nat) : Nat :=
  if a >= b then a else b

#eval maxNat (3) (7)
#eval maxNat 10 5
#eval max 8 8


-- 成绩等级
def grade (score : Nat) : String :=
  if score >= 90 then "优秀"
  else if score >= 80 then "良好"
  else if score >= 60 then "及格"
  else "不及格"

#eval grade 95
#eval grade 85
#eval grade 65
#eval grade 50

-- ============================================================================
-- 第七部分：let - 局部定义
-- ============================================================================

/-
`let` 用于在表达式中定义局部变量。

格式：
  let 名称 := 值
  后续表达式
-/

-- 使用 let 简化复杂计算
def complexCalc (x : Nat) : Nat :=
  let a := x + 1
  let b := a * 2
  let c := b - 3
  c + x

#eval complexCalc 5

-- 另一个例子
def circleArea (r : Float) : Float :=
  let pi := 3.14159
  pi * r * r

#eval circleArea 2.0
#eval circleArea 5.0


-- ============================================================================
-- 第八部分：列表和模式匹配
-- ============================================================================

/-
Lean 支持列表和一些简单的模式匹配。
-/

-- 定义列表
def numbers := [1, 2, 3, 4, 5]
def names := ["Alice", "Bob", "Charlie"]

#eval numbers
#eval names

-- 列表操作
#eval numbers.length
#eval [1, 2, 3] ++ [4, 5, 6]   -- 列表拼接
#eval [1, 2, 3].head!          -- 第一个元素
#eval [1, 2, 3].tail           -- 去掉第一个元素

-- ============================================================================
-- 第九部分：结构体
-- ============================================================================

/-
可以用 `structure` 定义复合数据类型。
-/

-- 定义一个点的结构
structure Point where
  x : Float
  y : Float
  deriving Repr

-- 创建点
def origin : Point := { x := 0.0, y := 0.0 }
def p1 : Point := { x := 3.0, y := 4.0 }

#eval origin
#eval p1

-- 访问字段
#eval p1.x
#eval p1.y

